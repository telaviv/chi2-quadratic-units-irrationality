/-
# The dual certificate for Theorem U (PROOF_U §5.4)

`exists_certU`: a `DualCertU` with `Φ < −27/20`; `exists_certU'`: with `Φ < −1.3538792` (the constant `Φ_L` of the
Theorem V margins).

The certificate is in the linear-majorant format (`Cert/Lin.lean`, `Cert/LinInstance.lean`): the data `DataU.data`
(generated by `scripts/gen_cert_lin.py 4 10 8 4`, run by `scripts/gen_cert_u.py`; untrusted) are checked by
`decide +kernel` in `Cert/DataU.lean` (no `native_decide`, no axioms; the log table in `Cert/LogTab.lean`):
`μ` piecewise constant on 10 cells of width `1/5` (heights dyadic `2^{-16}` in `[0, 1]`, mass exactly 1), grid `1/40` on
`[0, 4]` (160 cells), on each cell a linear majorant of `2U^μ + v` (the chord/tangent bounds of the terms
`D_j ψ(x − α_j/L)` summed, `Core.sum_sound`), charged by the trapezoid rule; `PhiQ ≈ −1.3541990 < −1.354`.
`DataU.cert` refines the grid (`LinCertU.exists_dual`) to a `DualCertU 4` with `Φ ≤ −1.354`.

History: until stage C1 the certificate was in the per-cell-maximum format of `Cert/Instance.lean` (`CDataU`, grid
`1/200`, 800 cells, `PhiQ ≈ −1.3538792442`, kernel check ≈ 6.5 min).
-/
import Chi2U.Cert.DataU

namespace Chi2U

open Cert in
/-- A certificate with `Φ < −1.3538792` exists (the constant `Φ_L` of the Theorem V margins). -/
theorem exists_certU' : ∃ C : DualCertU 4, C.Phi < -13538792 / 10000000 := by
  obtain ⟨C, hC⟩ := DataU.cert
  refine ⟨C, lt_of_le_of_lt hC ?_⟩
  norm_num

/-- A certificate with `Φ < −27/20` exists. -/
theorem exists_certU : ∃ C : DualCertU 4, C.Phi < -27 / 20 := by
  obtain ⟨C, hC⟩ := exists_certU'
  exact ⟨C, by linarith⟩

end Chi2U
