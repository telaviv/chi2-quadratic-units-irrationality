/-
# The dual certificate for Theorem U (PROOF_U §5.4): kernel checks

`exists_certU`: a `DualCertU` with `Φ < −27/20`. The data `DataU.data` (generated by
`scripts/gen_cert_u.py 50 8 4`, untrusted) is checked by `decide +kernel` (no `native_decide`, no axioms): every
field of `CDataU.Valid`, then `Instance.lean` turns the checks into a `DualCertU` (`toCert`) with `Φ ≤ PhiQ`
(`Phi_le`), and `PhiQ ≈ −1.3538792 < −27/20`.

The certificate: `μ` piecewise constant on 49 cells of width `1/25` (the optimiser of PROOF_U §5.3 on 50 cells of
`[0, 2]`, heights dyadic `2^{-16}` in `[0, 1]`, mass exactly 1), grid `1/200` on `[0, 4]` (800 cells), `λ ≈ −2.9629068`,
`−E_lo ≈ 1.2191333`, `(1/L) Σ (S_k − λ)₊ ≈ 0.3898942`. On each grid cell every term `D_j ψ(x − α_j/L)` of
`2U^μ + v` is bounded by its chord (convex part) or a tangent (concave part), and the linear bounds are summed
(`Core.cellOK_sound`); this keeps the cancellation between the cell potentials (the reason PROOF_U needed the near/far
split for its per-cell-maximum bound), and gives `Φ ≈ −1.35388` at `L = 200` (PROOF_U's Arb near/far certificate:
`−1.35644` at `L = 1600`).
-/
import Chi2U.Cert.DataU

namespace Chi2U

namespace Cert.DataU

open Chi2U.Cert CDataU

lemma tabOK : checkTab data.tab = true := by decide +kernel

lemma lwOK : data.lwOK = true := by decide +kernel

lemma cells0 : data.cellsOK 0 50 = true := by decide +kernel

lemma cells1 : data.cellsOK 50 50 = true := by decide +kernel

lemma cells2 : data.cellsOK 100 50 = true := by decide +kernel

lemma cells3 : data.cellsOK 150 50 = true := by decide +kernel

lemma cells4 : data.cellsOK 200 50 = true := by decide +kernel

lemma cells5 : data.cellsOK 250 50 = true := by decide +kernel

lemma cells6 : data.cellsOK 300 50 = true := by decide +kernel

lemma cells7 : data.cellsOK 350 50 = true := by decide +kernel

lemma cells8 : data.cellsOK 400 50 = true := by decide +kernel

lemma cells9 : data.cellsOK 450 50 = true := by decide +kernel

lemma cells10 : data.cellsOK 500 50 = true := by decide +kernel

lemma cells11 : data.cellsOK 550 50 = true := by decide +kernel

lemma cells12 : data.cellsOK 600 50 = true := by decide +kernel

lemma cells13 : data.cellsOK 650 50 = true := by decide +kernel

lemma cells14 : data.cellsOK 700 50 = true := by decide +kernel

lemma cells15 : data.cellsOK 750 50 = true := by decide +kernel

lemma EOK : data.EOK = true := by decide +kernel

lemma tailOK : data.tailOK = true := by decide +kernel

lemma cells_all : ∀ i < 16, data.cellsOK (50 * i) 50 = true := fun i hi =>
  match i, hi with
  | 0, _ => cells0
  | 1, _ => cells1
  | 2, _ => cells2
  | 3, _ => cells3
  | 4, _ => cells4
  | 5, _ => cells5
  | 6, _ => cells6
  | 7, _ => cells7
  | 8, _ => cells8
  | 9, _ => cells9
  | 10, _ => cells10
  | 11, _ => cells11
  | 12, _ => cells12
  | 13, _ => cells13
  | 14, _ => cells14
  | 15, _ => cells15
  | _ + 16, h => absurd h (by omega)

theorem valid : data.Valid where
  L1 := by decide
  X4 := by decide
  Ks := by decide
  len := by decide +kernel
  slen := by decide +kernel
  crange := by decide +kernel
  mass := by decide +kernel
  zlo0 := by decide +kernel
  zlo5 := by decide +kernel
  zhi2 := by decide +kernel
  zhi5 := by decide +kernel
  lw := lwOK
  tab := tabOK
  cells := data.cells_of_chunks 50 16 cells_all (by decide)
  tail := tailOK
  E := EOK

lemma phiQ_lt : data.PhiQ < -27 / 20 := by decide +kernel

end Cert.DataU

open Cert Cert.DataU in
/-- A certificate with `Φ < −27/20` exists. -/
theorem exists_certU : ∃ C : DualCertU, C.Phi < -27 / 20 := by
  refine ⟨CDataU.toCert valid, ?_⟩
  have h1 := CDataU.Phi_le valid
  have h2 : (data.PhiQ : ℝ) < -27 / 20 := by exact_mod_cast phiQ_lt
  linarith

end Chi2U
