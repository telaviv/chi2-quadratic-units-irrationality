/-! ## The real unit -/

lemma zT_facts {n : ℕ} (h3 : 3 ≤ n) :
    0 < zT n ∧ zT n ^ 2 - n * zT n + 1 = 0 ∧ zT n * ((n : ℝ) - 1) ≤ 1 := by
  have hn : (3 : ℝ) ≤ n := by exact_mod_cast h3
  set s := Real.sqrt (((n : ℝ) / 2) ^ 2 - 1) with hs
  have hx : 0 ≤ ((n : ℝ) / 2) ^ 2 - 1 := by nlinarith
  have hss : s ^ 2 = ((n : ℝ) / 2) ^ 2 - 1 := Real.sq_sqrt hx
  have hs0 : 0 ≤ s := Real.sqrt_nonneg _
  have hz : zT n = n / 2 - s := rfl
  have hlt : s < n / 2 := by nlinarith
  have hge : (n : ℝ) / 2 - 1 ≤ s := by nlinarith
  have hq : zT n ^ 2 - n * zT n + 1 = 0 := by rw [hz]; nlinarith
  refine ⟨by rw [hz]; linarith, hq, ?_⟩
  have hz1 : zT n ≤ 1 := by rw [hz]; linarith
  have hz0 : 0 < zT n := by rw [hz]; linarith
  nlinarith

/-- `log z_n ≤ −log n + 1/(n − 1)²` (from `n z = 1 + z²`, `log(1 + z²) ≤ z²`, `z ≤ 1/(n − 1)`). -/
lemma log_zT_le {n : ℕ} (h3 : 3 ≤ n) : Real.log (zT n) ≤ -Real.log n + 1 / ((n : ℝ) - 1) ^ 2 := by
  obtain ⟨hz0, hq, hz1⟩ := zT_facts h3
  have hn : (3 : ℝ) ≤ n := by exact_mod_cast h3
  have hmul : Real.log ((n : ℝ) * zT n) = Real.log n + Real.log (zT n) :=
    Real.log_mul (by positivity) hz0.ne'
  have he : (n : ℝ) * zT n = 1 + zT n ^ 2 := by linarith
  have hl : Real.log ((n : ℝ) * zT n) ≤ zT n ^ 2 := by
    rw [he]; linarith [Real.log_le_sub_one_of_pos (by positivity : (0 : ℝ) < 1 + zT n ^ 2)]
  have hsq : zT n ^ 2 ≤ 1 / ((n : ℝ) - 1) ^ 2 := by
    rw [le_div_iff₀ (by nlinarith)]
    have : (zT n * ((n : ℝ) - 1)) ^ 2 ≤ 1 := by
      have h0 : 0 ≤ zT n * ((n : ℝ) - 1) := by nlinarith
      nlinarith
    nlinarith
  linarith

/-! ## The reduction -/

/-- `M(n) ≤ K + c₂ − ν log 2/4 + G(n) − ¼ log n + 1/(2(n − 1)²)`. -/
lemma margin_le {n : ℕ} (h3 : 3 ≤ n) :
    alphaT n + betaT n ≤ 4 / 3 + PhiL + (144363548049039 : ℝ) / 100000000000000 / 2 + c2T n -
      (padicValNat 2 n : ℝ) * Real.log 2 / 4 + VOdd.Gs n - Real.log n / 4 + 1 / (2 * ((n : ℝ) - 1) ^ 2) := by
  have h1 := log_zT_le h3
  have h2 := VOdd.log_sqrt5_le
  have hc := cSV_eq n
  have hl := log_nat_eq (show n ≠ 0 by omega)
  have e : 1 / (2 * ((n : ℝ) - 1) ^ 2) = 1 / ((n : ℝ) - 1) ^ 2 / 2 := by
    rw [div_div, mul_comm]
  unfold alphaT betaT LshiftT VOdd.Gs
  rw [log_zU_four, e]
  linarith

lemma padic_odd {n : ℕ} (h : n % 2 = 1) : padicValNat 2 n = 0 :=
  padicValNat.eq_zero_of_not_dvd (by omega)

lemma padic_nu1 {n : ℕ} (h : n % 4 = 2) : padicValNat 2 n = 1 := by
  have e : n = 2 * (n / 2) := by omega
  rw [e, padicValNat.mul (by norm_num) (by omega), padicValNat.self (by norm_num),
    padicValNat.eq_zero_of_not_dvd (by omega)]

lemma padic_nu2 {n : ℕ} (h : n % 4 = 0) (h0 : n ≠ 0) : 2 ≤ padicValNat 2 n := by
  have := Fact.mk Nat.prime_two
  exact (padicValNat_dvd_iff_le h0).mp (Nat.dvd_of_mod_eq_zero (by norm_num; omega))

/-- Odd `n`: `M(n) ≤ K + ½ log 2 + G(n) − ¼ log n + d`. -/
lemma margin_odd {n : ℕ} {d : ℝ} (ho : n % 2 = 1) (h5 : 5 ≤ n) (hd : 1 / (2 * ((n : ℝ) - 1) ^ 2) ≤ d)
    (hB : 4 / 3 + PhiL + (144363548049039 : ℝ) / 100000000000000 / 2 + Real.log 2 / 2 + VOdd.Gs n -
      Real.log n / 4 + d < 0) : alphaT n + betaT n < 0 := by
  have h := margin_le (show 3 ≤ n by omega)
  have hc : c2T n = Real.log 2 / 2 := by unfold c2T; simp [ho]
  rw [hc, padic_odd ho] at h
  push_cast at h
  linarith

/-- `n ≡ 2 mod 4`: `M(n) ≤ K + G(n) − ¼ log n + d`. -/
lemma margin_nu1 {n : ℕ} {d : ℝ} (h4 : n % 4 = 2) (h5 : 5 ≤ n) (hd : 1 / (2 * ((n : ℝ) - 1) ^ 2) ≤ d)
    (hB : 4 / 3 + PhiL + (144363548049039 : ℝ) / 100000000000000 / 2 + VOdd.Gs n - Real.log n / 4 + d < 0) :
    alphaT n + betaT n < 0 := by
  have h := margin_le (show 3 ≤ n by omega)
  have hc : c2T n = Real.log 2 / 4 := by
    have h2 : ¬ n % 2 = 1 := by omega
    unfold c2T; simp only [h2, ↓reduceIte]; rw [padic_nu1 h4]; norm_num
  rw [hc, padic_nu1 h4] at h
  push_cast at h
  linarith

lemma delta_le {n k : ℕ} (hk : 2 ≤ k) (h : k ≤ n) :
    1 / (2 * ((n : ℝ) - 1) ^ 2) ≤ 1 / (2 * ((k : ℝ) - 1) ^ 2) := by
  have hk' : (2 : ℝ) ≤ k := by exact_mod_cast hk
  have h' : (k : ℝ) ≤ n := by exact_mod_cast h
  apply one_div_le_one_div_of_le (by nlinarith)
  nlinarith

/-- `n ≡ 0 mod 4` (`ν ≥ 2`, `n ≥ 8`): `M(n) ≤ K − (9/8) log 2 + 1/98 < 0`. -/
lemma margin_nu2 {n : ℕ} (h4 : n % 4 = 0) (h5 : 5 ≤ n) : alphaT n + betaT n < 0 := by
  have h8 : 8 ≤ n := by omega
  have h := margin_le (show 3 ≤ n by omega)
  have hν := padic_nu2 h4 (by omega)
  have hν' : (2 : ℝ) ≤ padicValNat 2 n := by exact_mod_cast hν
  have hc : c2T n = ((padicValNat 2 n : ℝ) - 2) * Real.log 2 / 4 := by
    have h2 : ¬ n % 2 = 1 := by omega
    unfold c2T; simp only [h2, ↓reduceIte]; rw [abs_of_nonneg (by linarith)]
  rw [hc] at h
  have hd := delta_le (n := n) (k := 8) (by norm_num) h8
  have hG := sum_g_le n
  have hl := log_nat_eq (show n ≠ 0 by omega)
  have hl8 : Real.log 8 ≤ Real.log n := Real.log_le_log (by norm_num) (by exact_mod_cast h8)
  have e8 : Real.log 8 = 3 * Real.log 2 := by
    rw [show (8 : ℝ) = 2 ^ 3 by norm_num, Real.log_pow]; norm_num
  have hl2 := Real.log_two_gt_d9
  have hν2 : 2 * Real.log 2 ≤ (padicValNat 2 n : ℝ) * Real.log 2 := by nlinarith
  unfold VOdd.Gs at h
  push_cast at hd
  unfold PhiL at h
  linarith

lemma llo138 : (4927253685157204 : ℝ) / 1000000000000000 ≤ Real.log 138 := by
  exact_mod_cast VOdd.logN_ge (n := 138) (u := 4927253685157204) (v := 1000000000000000) (by decide +kernel)

/-- `n ≡ 2 mod 4`, `n ≥ 138`: `M(n) ≤ K − ⅛ log 2 − ⅛ log 138 + 1/(2·137²) < 0`. -/
lemma margin_nu1_large {n : ℕ} (h4 : n % 4 = 2) (hn : 138 ≤ n) : alphaT n + betaT n < 0 := by
  refine margin_nu1 h4 (by omega) (delta_le (k := 138) (by norm_num) hn) ?_
  have hG := sum_g_le n
  have hl := log_nat_eq (show n ≠ 0 by omega)
  rw [padic_nu1 h4] at hl
  have hla : Real.log 138 ≤ Real.log n := Real.log_le_log (by norm_num) (by exact_mod_cast hn)
  have := llo138
  have := Real.log_two_gt_d9
  unfold VOdd.Gs
  push_cast at hl ⊢
  unfold PhiL
  linarith

/-- Odd `n ≥ 275`: `M(n) ≤ K + ½ log 2 + log 3/10 + 3 log 5/80 + log 7/60 − (9/40) log 275 + 1/(2·274²) < 0`. -/
lemma margin_odd_large {n : ℕ} (ho : n % 2 = 1) (hn : 275 ≤ n) : alphaT n + betaT n < 0 := by
  refine margin_odd ho (by omega) (delta_le (k := 275) (by norm_num) hn) ?_
  have key : VOdd.Gs n - Real.log n / 4 + 9 / 40 * Real.log n =
      ∑ p ∈ oddDiv n, (1 / (4 * ((p : ℝ) - 1)) - (padicValNat p n : ℝ) / 40) * Real.log p := by
    rw [VOdd.log_odd ho]; unfold VOdd.Gs
    rw [sum_div, mul_sum, ← sum_sub_distrib, ← sum_add_distrib]
    apply sum_congr rfl; intro p _; ring
  have hT := sum_le_sum (fun p hp => VOdd.term_le (a := n) (p := p) hp)
  have hH := VOdd.sum_hcor_le (oddDiv n)
  have hla : Real.log 275 ≤ Real.log n := Real.log_le_log (by norm_num) (by exact_mod_cast hn)
  have := VOdd.lhi3; have := VOdd.lhi5; have := VOdd.lhi7; have := VOdd.llo275
  have := Real.log_two_lt_d9
  push_cast
  unfold PhiL
  linarith

macro "case_close" "[" hs:term,* "]" : tactic =>
  `(tactic| ((try unfold PhiL); push_cast; linarith [Real.log_two_gt_d9, Real.log_two_lt_d9, $hs,*]))

